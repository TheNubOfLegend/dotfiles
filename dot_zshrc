pacview() {
    # Default to -Qq if no arguments are provided
    local args
    if [ $# -eq 0 ]; then
        args=(-Qq)
    else
        args=("$@")
    fi

    # Run FZF and capture the selected packages
    local selected=$(pacman "${args[@]}" | fzf -m --ansi \
      --preview 'pacman -Qil {}' \
      --layout=reverse \
      --header ' [Tab] Select/Flag  |  [Enter] View Full Info  |  [Ctrl-D] Confirm Selection' \
      --bind 'enter:execute(pacman -Qil {} | less)' \
      --bind 'ctrl-d:accept')

    # If you selected packages and pressed Ctrl-D, prompt for removal
    if [ -n "$selected" ]; then
        echo -e "\nPackages selected for removal:\n$selected\n"
        read -k 1 "confirm?Proceed with mass uninstall? (y/N): "
        echo # Print a newline after the single-key read
        if [[ $confirm == [yY] ]]; then
            # Convert newlines to spaces and run pacman
            sudo pacman -Rns $(echo "$selected" | tr '\n' ' ')
        else
            echo "Cancelled."
        fi
    fi
}

