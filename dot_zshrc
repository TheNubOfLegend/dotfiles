alias test='echo "Using /usr/bin/test, not test file"; test'

function lswitch() {
    if [ -t 1 ]; then
        eza --group-directories-first "$@"
    else
        command ls "$@"
    fi
}

if command -v eza 2>&1 >/dev/null; then 
  alias ls=lswitch
else
  echo "Missing eza"
fi

